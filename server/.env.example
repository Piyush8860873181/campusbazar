# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusbazar?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campusbazar

# In-memory MongoDB fallback for local development testing if no MongoDB is installed locally
USE_MEMORY_DB=true

# JWT Secret for signing authentication tokens
JWT_SECRET=super_secret_jwt_campusbazar_key_2026

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration (Optional for local, Required for Render deployment)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
